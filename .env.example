# ─────────────────────────────────────────────────────────────────────────────
# Mkataba — Environment Variables
# Copy this file to .env and fill in all values before running docker compose up
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ─── Mkataba PostgreSQL ───────────────────────────────────────────────────────
POSTGRES_DB=mkataba
POSTGRES_USER=mkataba
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS

# Full connection URL (auto-constructed from above in docker-compose)
DATABASE_URL=postgresql://mkataba:CHANGE_ME_STRONG_PASSWORD_32CHARS@mkataba-db:5432/mkataba?schema=public

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000
# In production, set to your public domain: https://mkataba.yourdomain.com

# ─── DocuSeal ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
DOCUSEAL_SECRET_KEY_BASE=CHANGE_ME_openssl_rand_base64_64
# Get API token from DocuSeal admin UI after first boot (http://localhost:3001 during setup)
DOCUSEAL_API_TOKEN=CHANGE_ME_from_docuseal_admin
# Generate with: openssl rand -hex 32
DOCUSEAL_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── Paperless-ngx ───────────────────────────────────────────────────────────
PAPERLESS_DB_NAME=paperless
PAPERLESS_DB_USER=paperless
PAPERLESS_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS
# Generate with: openssl rand -base64 64
PAPERLESS_SECRET_KEY=CHANGE_ME_openssl_rand_base64_64
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
PAPERLESS_ADMIN_EMAIL=admin@yourdomain.com
PAPERLESS_PUBLIC_URL=http://localhost:8000
# Get API token from Paperless admin UI after first boot
PAPERLESS_API_TOKEN=CHANGE_ME_from_paperless_admin

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourmailprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Mkataba <noreply@yourdomain.com>"

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
APPROVAL_TOKEN_SECRET=CHANGE_ME_openssl_rand_hex_32
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# ─── Timezone ────────────────────────────────────────────────────────────────
TZ=Africa/Nairobi
