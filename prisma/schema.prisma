// Mkataba — Prisma Schema
// PostgreSQL 16 | Prisma 5.x
// UUIDs generated at DB level via gen_random_uuid()

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  LEGAL_REVIEWER
  APPROVER
  STANDARD_USER
}

enum ContractStatus {
  DRAFT
  UNDER_REVIEW
  PENDING_APPROVAL
  APPROVED
  PENDING_SIGNATURE
  EXECUTED
  ARCHIVED
  REJECTED
  VOID
  EXPIRED
}

enum ContractType {
  SERVICE_AGREEMENT
  NDA
  EMPLOYMENT
  VENDOR
  LEASE
  PARTNERSHIP
  GRANT
  PROCUREMENT
  OTHER
}

enum WorkflowType {
  SEQUENTIAL
  PARALLEL
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum AuditAction {
  VIEW
  CREATED
  UPDATED
  SUBMITTED
  APPROVED
  REJECTED
  SENT_FOR_SIGNING
  SIGNED
  EXECUTED
  ARCHIVED
  VOIDED
  DELETED
  PERMISSION_CHANGED
  TEMPLATE_USED
  VERSION_RESTORED
  COMMENT_ADDED
  ATTACHMENT_UPLOADED
  ATTACHMENT_DELETED
}

enum TemplateVariableType {
  TEXT
  NUMBER
  DATE
  EMAIL
  PHONE
  CURRENCY
  BOOLEAN
  SELECT
}

// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION (Tenant)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  slug        String   @unique
  logoUrl     String?
  website     String?
  industry    String?
  country     String?  @default("KE")
  currency    String?  @default("KES")
  settings    Json?    @default("{}")

  users       User[]
  contracts   Contract[]
  templates   Template[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("organizations")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  email          String       @unique
  emailVerified  DateTime?
  passwordHash   String
  name           String
  avatarUrl      String?
  role           UserRole     @default(STANDARD_USER)
  isActive       Boolean      @default(true)
  lastLoginAt    DateTime?
  loginCount     Int          @default(0)
  preferences    Json?        @default("{}")

  // Auth.js session support
  sessions       Session[]
  accounts       Account[]

  // Contract relationships
  createdContracts   Contract[]          @relation("ContractCreator")
  contractVersions   ContractVersion[]
  approvalSteps      ApprovalStep[]      @relation("ApprovalStepAssignee")
  auditLogs          AuditLog[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@map("users")
}

// Auth.js required models
model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
  ipAddress    String?
  userAgent    String?

  @@map("sessions")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTRACT
// ─────────────────────────────────────────────────────────────────────────────

model Contract {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id])

  title          String
  type           ContractType   @default(OTHER)
  status         ContractStatus @default(DRAFT)
  description    String?        @db.Text

  // Parties
  creatorId      String         @db.Uuid
  creator        User           @relation("ContractCreator", fields: [creatorId], references: [id])
  counterpartyName    String?
  counterpartyEmail   String?
  counterpartyCompany String?

  // Financial
  value          Decimal?       @db.Decimal(18, 2)
  currency       String?        @default("KES")

  // Dates
  effectiveDate  DateTime?
  expirationDate DateTime?
  signedAt       DateTime?
  executedAt     DateTime?

  // Version tracking
  currentVersionId String?      @db.Uuid
  currentVersion   ContractVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions         ContractVersion[] @relation("AllVersions")

  // DocuSeal integration
  docusealSubmissionId  String?
  docusealStatus        String?   // pending | completed | declined | expired
  docusealSigningUrl    String?
  signingRequestedAt    DateTime?

  // Paperless-ngx integration
  paperlessDocumentId   Int?
  paperlessTaskId       String?   // async task ID returned by Paperless
  archivedAt            DateTime?

  // Template origin
  templateId     String?        @db.Uuid
  template       Template?      @relation(fields: [templateId], references: [id])

  // Rejection tracking
  rejectedAt     DateTime?
  rejectionReason String?       @db.Text

  // Relationships
  approvalWorkflows ApprovalWorkflow[]
  attachments       Attachment[]
  auditLogs         AuditLog[]
  comments          ContractComment[]

  // Metadata tags for search
  tags           String[]       @default([])

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([status])
  @@index([creatorId])
  @@index([expirationDate])
  @@index([docusealSubmissionId])
  @@map("contracts")
}

model ContractVersion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId  String   @db.Uuid
  contract    Contract @relation("AllVersions", fields: [contractId], references: [id])

  versionNumber Int
  body          String   @db.Text     // HTML content from rich-text editor
  bodyPlainText String?  @db.Text     // Stripped version for search/OCR
  changeNote    String?

  editorId    String   @db.Uuid
  editor      User     @relation(fields: [editorId], references: [id])

  // Back-reference: Contract.currentVersion → this
  currentFor  Contract[] @relation("CurrentVersion")

  createdAt   DateTime @default(now())

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@map("contract_versions")
}

model ContractComment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId  String   @db.Uuid
  contract    Contract @relation(fields: [contractId], references: [id])
  authorId    String   @db.Uuid
  content     String   @db.Text
  isResolved  Boolean  @default(false)
  resolvedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contractId])
  @@map("contract_comments")
}

// ─────────────────────────────────────────────────────────────────────────────
// TEMPLATE
// ─────────────────────────────────────────────────────────────────────────────

model Template {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id])

  name           String
  description    String?      @db.Text
  type           ContractType @default(OTHER)
  body           String       @db.Text   // HTML with {{variable}} placeholders
  isPublished    Boolean      @default(false)
  usageCount     Int          @default(0)
  category       String?

  variables      TemplateVariable[]
  contracts      Contract[]

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@map("templates")
}

model TemplateVariable {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId   String               @db.Uuid
  template     Template             @relation(fields: [templateId], references: [id], onDelete: Cascade)

  key          String               // e.g., "party_name"
  label        String               // e.g., "Party Name"
  type         TemplateVariableType @default(TEXT)
  placeholder  String?
  defaultValue String?
  required     Boolean              @default(true)
  order        Int                  @default(0)
  options      String[]             @default([]) // For SELECT type

  @@unique([templateId, key])
  @@index([templateId])
  @@map("template_variables")
}

// ─────────────────────────────────────────────────────────────────────────────
// APPROVAL WORKFLOW
// ─────────────────────────────────────────────────────────────────────────────

model ApprovalWorkflow {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId  String       @db.Uuid
  contract    Contract     @relation(fields: [contractId], references: [id])

  type        WorkflowType @default(SEQUENTIAL)
  isCompleted Boolean      @default(false)
  completedAt DateTime?
  isRejected  Boolean      @default(false)
  rejectedAt  DateTime?

  steps       ApprovalStep[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([contractId])
  @@map("approval_workflows")
}

model ApprovalStep {
  id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId  String             @db.Uuid
  workflow    ApprovalWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  assigneeId  String             @db.Uuid
  assignee    User               @relation("ApprovalStepAssignee", fields: [assigneeId], references: [id])

  order       Int                // For sequential workflows
  status      ApprovalStepStatus @default(PENDING)
  note        String?            @db.Text

  // One-tap approval token
  approvalToken    String?        @unique
  tokenExpiresAt   DateTime?
  tokenUsedAt      DateTime?

  notifiedAt  DateTime?
  respondedAt DateTime?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([workflowId])
  @@index([assigneeId])
  @@index([status])
  @@map("approval_steps")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTACHMENT
// ─────────────────────────────────────────────────────────────────────────────

model Attachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId  String   @db.Uuid
  contract    Contract @relation(fields: [contractId], references: [id])

  filename    String
  mimeType    String
  sizeBytes   Int
  storagePath String   // Path on Docker volume
  checksum    String   // SHA-256 of file content

  uploadedById String   @db.Uuid
  isSignedPdf  Boolean  @default(false) // True for the final DocuSeal output

  createdAt   DateTime @default(now())

  @@index([contractId])
  @@map("attachments")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG (append-only, no updates/deletes)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId  String?     @db.Uuid
  contract    Contract?   @relation(fields: [contractId], references: [id])

  userId      String      @db.Uuid
  user        User        @relation(fields: [userId], references: [id])

  action      AuditAction
  metadata    Json?       // Diff data, field changes, etc.
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime    @default(now())

  @@index([contractId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// JOB QUEUE (pg-boss compatible)
// ─────────────────────────────────────────────────────────────────────────────

model BackgroundJob {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   // e.g., "archive-contract", "send-approval-email"
  payload     Json
  status      String   @default("pending") // pending | running | completed | failed
  attempts    Int      @default(0)
  maxAttempts Int      @default(3)
  error       String?  @db.Text
  scheduledAt DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([name, status])
  @@index([scheduledAt])
  @@map("background_jobs")
}
